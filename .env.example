# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# Resend API key (https://resend.com/api-keys). Server-side only.
RESEND_API_KEY=

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=

# Public site URL, no trailing slash. Used for canonical URLs, OG images, sitemap.
NEXT_PUBLIC_SITE_URL=https://prachyabiswas.com
